@model ColegioSanJose.Models.Carrera

@{
    ViewData["Title"] = "Agregar carrera";
}

<h1>Agregar carrera</h1>

<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="NombreCarrera" class="control-label">Nombre de la carrera</label>
                        <input asp-for="NombreCarrera" class="form-control" placeholder="Ejemplo: Ing. Desarrollo de Software" />
                        <span asp-validation-for="NombreCarrera" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Guardar" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}