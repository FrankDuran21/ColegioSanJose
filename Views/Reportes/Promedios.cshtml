@model IEnumerable<ColegioSanJose.ViewModels.PromedioAlumnoViewModel>

@{
    ViewData["Title"] = "Promedios por alumno";
}

<h1>Promedios por alumno</h1>

<p>
    Esta vista muestra el promedio de notas obtenido por cada alumno, tomando como base los registros del expediente académico.
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Alumno</th>
            <th>Grado</th>
            <th>Cantidad de materias</th>
            <th>Promedio de notas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCompleto</td>
                <td>@item.Grado</td>
                <td>@item.CantidadMaterias</td>
                <td>@item.PromedioNotas.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>