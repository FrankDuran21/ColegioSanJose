@model ColegioSanJose.Models.Materia

@{
    ViewData["Title"] = "Detalles de la materia";
}

<h1>Detalles de la materia</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nombre de la materia</dt>
            <dd class="col-sm-9">@Model.NombreMateria</dd>

            <dt class="col-sm-3">Docente</dt>
            <dd class="col-sm-9">@Model.Docente</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.MateriaId" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>