@model ColegioSanJose.Models.Materia

@{
    ViewData["Title"] = "Eliminar materia";
}

<h1>Eliminar materia</h1>

<div class="alert alert-danger">
    ¿Está seguro que desea eliminar esta materia?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nombre de la materia</dt>
            <dd class="col-sm-9">@Model.NombreMateria</dd>

            <dt class="col-sm-3">Docente</dt>
            <dd class="col-sm-9">@Model.Docente</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="MateriaId" />
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>