@model IEnumerable<ColegioSanJose.Models.Alumno>

@{
    ViewData["Title"] = "Listado de alumnos";

    var filtro = ViewData["FiltroActual"] as string;
    var gradoActual = ViewData["GradoActual"] as string;
    var ordenActual = ViewData["OrdenActual"] as string;
    var grados = ViewBag.Grados as List<string>;
}

<h1>Listado de alumnos</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label class="form-label">Buscar por nombre o apellido</label>
                    <input type="text"
                           name="buscar"
                           value="@filtro"
                           class="form-control"
                           placeholder="Ejemplo: Francisco, Durán, Katherine..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Filtrar por grado</label>
                    <select name="grado" class="form-control">
                        <option value="">Todos los grados</option>

                        @if (grados != null)
                        {
                            foreach (var grado in grados)
                            {
                                if (grado == gradoActual)
                                {
                                    <option value="@grado" selected>@grado</option>
                                }
                                else
                                {
                                    <option value="@grado">@grado</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ordenar</label>
                    <select name="orden" class="form-control">
                        @if (ordenActual == "az" || string.IsNullOrEmpty(ordenActual))
                        {
                            <option value="az" selected>A - Z</option>
                        }
                        else
                        {
                            <option value="az">A - Z</option>
                        }

                        @if (ordenActual == "za")
                        {
                            <option value="za" selected>Z - A</option>
                        }
                        else
                        {
                            <option value="za">Z - A</option>
                        }

                        @if (ordenActual == "grado")
                        {
                            <option value="grado" selected>Grado</option>
                        }
                        else
                        {
                            <option value="grado">Grado</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 mb-2">Buscar</button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Agregar alumno</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No se encontraron alumnos con los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table-dark-custom">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Fecha de nacimiento</th>
                    <th>Grado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td>@item.Grado</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.AlumnoId" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.AlumnoId" class="btn btn-info btn-sm">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.AlumnoId" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}