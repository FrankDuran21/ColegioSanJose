@model ColegioSanJose.Models.Alumno

@{
    ViewData["Title"] = "Detalles del alumno";
}

<h1>Detalles del alumno</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Apellido</dt>
            <dd class="col-sm-9">@Model.Apellido</dd>

            <dt class="col-sm-3">Fecha de nacimiento</dt>
            <dd class="col-sm-9">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Grado</dt>
            <dd class="col-sm-9">@Model.Grado</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.AlumnoId" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>