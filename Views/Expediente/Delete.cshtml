@model ColegioSanJose.Models.Expediente

@{
    ViewData["Title"] = "Eliminar expediente";
}

<h1>Eliminar expediente</h1>

<div class="alert alert-danger">
    ¿Está seguro que desea eliminar este expediente?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Alumno</dt>
            <dd class="col-sm-9">
                @(Model.Alumno != null ? Model.Alumno.Nombre + " " + Model.Alumno.Apellido : "")
            </dd>

            <dt class="col-sm-3">Materia</dt>
            <dd class="col-sm-9">
                @(Model.Materia != null ? Model.Materia.NombreMateria : "")
            </dd>

            <dt class="col-sm-3">Nota final</dt>
            <dd class="col-sm-9">@Model.NotaFinal.ToString("0.00")</dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">@Model.Observaciones</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ExpedienteId" />
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>