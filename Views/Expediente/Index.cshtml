@model IEnumerable<ColegioSanJose.ViewModels.ExpedienteAlumnoViewModel>

@{
    ViewData["Title"] = "Expedientes por alumno";

    var filtro = ViewData["FiltroActual"] as string;
    var gradoActual = ViewData["GradoActual"] as string;
    var ordenActual = ViewData["OrdenActual"] as string;
    var grados = ViewBag.Grados as List<string>;
}

<h1>Expedientes por alumno</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label class="form-label">Buscar alumno, materia, docente u observación</label>
                    <input type="text"
                           name="buscar"
                           value="@filtro"
                           class="form-control"
                           placeholder="Ejemplo: Francisco, Matemática, buen desempeño..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Filtrar por grado/sección</label>
                    <select name="grado" class="form-control">
                        <option value="">Todos los grados</option>

                        @if (grados != null)
                        {
                            foreach (var grado in grados)
                            {
                                if (grado == gradoActual)
                                {
                                    <option value="@grado" selected>@grado</option>
                                }
                                else
                                {
                                    <option value="@grado">@grado</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ordenar</label>
                    <select name="orden" class="form-control">

                        @if (ordenActual == "az" || string.IsNullOrEmpty(ordenActual))
                        {
                            <option value="az" selected>A - Z</option>
                        }
                        else
                        {
                            <option value="az">A - Z</option>
                        }

                        @if (ordenActual == "za")
                        {
                            <option value="za" selected>Z - A</option>
                        }
                        else
                        {
                            <option value="za">Z - A</option>
                        }

                        @if (ordenActual == "grado")
                        {
                            <option value="grado" selected>Grado</option>
                        }
                        else
                        {
                            <option value="grado">Grado</option>
                        }

                        @if (ordenActual == "promedio_desc")
                        {
                            <option value="promedio_desc" selected>Mayor promedio</option>
                        }
                        else
                        {
                            <option value="promedio_desc">Mayor promedio</option>
                        }

                        @if (ordenActual == "promedio_asc")
                        {
                            <option value="promedio_asc" selected>Menor promedio</option>
                        }
                        else
                        {
                            <option value="promedio_asc">Menor promedio</option>
                        }

                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 mb-2">Buscar</button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Agregar expediente</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No se encontraron alumnos o expedientes con los filtros seleccionados.
    </div>
}
else
{
    <div class="accordion" id="accordionExpedientes">

        @foreach (var alumno in Model)
        {
            var collapseId = "alumno" + alumno.AlumnoId;
            var promedioClase = alumno.Promedio >= 6.00m ? "badge bg-success" : "badge bg-danger";

            <div class="accordion-item mb-3">

                <h2 class="accordion-header" id="heading-@collapseId">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">

                        <div class="w-100 d-flex flex-wrap justify-content-between align-items-center">

                            <div>
                                <strong>@alumno.NombreCompleto</strong>
                                <span class="ms-2 text-muted">Grado: @alumno.Grado</span>
                            </div>

                            <div class="me-4">
                                <span class="badge bg-primary me-2">
                                    Materias: @alumno.CantidadMaterias
                                </span>

                                <span class="@promedioClase">
                                    Promedio: @alumno.Promedio.ToString("0.00")
                                </span>
                            </div>

                        </div>
                    </button>
                </h2>

                <div id="@collapseId"
                     class="accordion-collapse collapse"
                     aria-labelledby="heading-@collapseId"
                     data-bs-parent="#accordionExpedientes">

                    <div class="accordion-body">

                        @if (!alumno.Expedientes.Any())
                        {
                            <p class="text-muted mb-0">
                                Este alumno aún no tiene materias registradas en su expediente.
                            </p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Materia</th>
                                            <th>Docente</th>
                                            <th>Nota final</th>
                                            <th>Estado</th>
                                            <th>Observaciones</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var expediente in alumno.Expedientes)
                                        {
                                            var estado = expediente.NotaFinal >= 6.00m ? "Aprobado" : "Reprobado";
                                            var estadoClase = expediente.NotaFinal >= 6.00m ? "badge bg-success" : "badge bg-danger";

                                            <tr>
                                                <td>@expediente.Materia</td>
                                                <td>@expediente.Docente</td>
                                                <td>@expediente.NotaFinal.ToString("0.00")</td>

                                                <td>
                                                    <span class="@estadoClase">@estado</span>
                                                </td>

                                                <td>@expediente.Observaciones</td>

                                                <td>
                                                    <a asp-action="Edit"
                                                       asp-route-id="@expediente.ExpedienteId"
                                                       class="btn btn-warning btn-sm">
                                                        Editar
                                                    </a>

                                                    <a asp-action="Details"
                                                       asp-route-id="@expediente.ExpedienteId"
                                                       class="btn btn-info btn-sm">
                                                        Detalles
                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-route-id="@expediente.ExpedienteId"
                                                       class="btn btn-danger btn-sm">
                                                        Eliminar
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>

            </div>
        }

    </div>
}